# MongoDB connection string (optional - app uses JSON file DB by default)
# MONGO_URL=mongodb+srv://user:pass@cluster.mongodb.net/careai

# Database name
DB_NAME=careai

# Path where db.json is stored. On Render, point to the persistent disk mount.
# DB_DIR=/data   ← set this as an env var in Render dashboard (already in render.yaml)

# JWT secret (Render auto-generates this via render.yaml generateValue: true)
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256

# OpenAI API key for GPT-4o-mini chatbot
# Get one at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# CORS origins: comma-separated list of allowed frontend URLs (no spaces after commas)
# Example: https://your-app.vercel.app,http://localhost:3000
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000,http://localhost:3002

# Backend URL for the React frontend (set in .env in project root)
# Replace with your actual Render service URL
REACT_APP_BACKEND_URL=https://your-backend.onrender.com
